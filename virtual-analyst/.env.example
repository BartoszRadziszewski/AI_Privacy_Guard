# --- Serwer ---
PORT=3000

# --- Silnik Multi-LLM ---
# do wyboru: anthropic | openai | gemini
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# --- Awatar i głos ---
HEYGEN_API_KEY=your_heygen_key
# Opcjonalnie: nazwa awatara interaktywnego z panelu HeyGen (puste = domyślny)
HEYGEN_AVATAR_NAME=

ELEVENLABS_API_KEY=your_elevenlabs_key
# Opcjonalnie: ID głosu ElevenLabs (puste = domyślny głos multilingual)
ELEVENLABS_VOICE_ID=
